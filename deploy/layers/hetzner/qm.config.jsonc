{
  // Hetzner single-VM deployment — docker target + SANDBOX_BACKEND=local.
  // Operator: replace <org-slug> and <public-url>; confirm modelProvider (default
  // anthropic — change if you use openai/openrouter) and the sign-in route (see README.md).
  // Postgres is managed by qm (it starts a `pg` container and injects DATABASE_URL
  // into core); do NOT set DATABASE_URL here or in .env.
  // This template adapts the `qm init --target docker` output for a single Hetzner VM
  // with co-located Docker sandboxes (no Fly dependency). Run `qm init` on the VM to
  // generate .env.example, .gitignore, package.json, deployment.md, and sandbox/
  // scaffolding, then overlay (overwrite) this file.

  "contract": 1,
  "orgId": "<org-slug>",
  "publicUrl": "https://<public-url>",

  "target": "docker",
  "modelProvider": "anthropic",

  "services": ["core", "web-ui", "admin", "portal", "auth"],

  "plugins": [],
  "skills": [],

  "env": {
    "core": {
      "HARNESS": "pi",
      "NODE_ENV": "production",
      "SANDBOX_BACKEND": "local"
    },
    "auth": {
      "AUTH_EMAIL_TRANSPORT": "smtp"
    }
  },

  "secretEnv": {
    "core": {
      "ADMIN_GRANTS": "ADMIN_GRANTS",
      "PUBLIC_API_URL": "PUBLIC_API_URL"
    }
  }
}
